{
  // The repo previously had no ESLint config at all, so `npm run lint` only ever
  // printed Next.js's interactive setup prompt and never linted anything. That is
  // how a Rules-of-Hooks violation (with an eslint-disable comment sitting right
  // on top of it) and a contradictory ARIA attribute pair stayed in the codebase.
  //
  // Severity policy:
  //   error - correctness rules. These catch the bug classes fixed in Aug 2026;
  //           they must never regress.
  //   warn  - a pre-existing backlog (~125 findings, mostly typographic) that is
  //           deliberately NOT addressed here. Left visible rather than disabled.
  "root": true,
  "extends": ["next/core-web-vitals"],
  "rules": {
    // --- correctness: must stay errors ---
    "react-hooks/rules-of-hooks": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/role-has-required-aria-props": "error",

    // --- pre-existing backlog: visible as warnings, not blocking ---
    // Purely typographic (raw ' and " in JSX text). No runtime effect.
    "react/no-unescaped-entities": "warn",
    "react/display-name": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "@next/next/no-html-link-for-pages": "warn",
    "@next/next/no-assign-module-variable": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "dev-scripts/",
    "archive-docs/",
    "_wip/",
    ".claude/",
    "public/",
    "scripts/*.js"
  ]
}
